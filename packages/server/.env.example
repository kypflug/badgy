# --- Local development ---
# Pretend to be this signed-in user so the API persistence path works locally
# (without real AAD). Any value enables the dev identity.
DEV_USER=you@example.com

# Port the server listens on.
PORT=8080

# Path to the built web SPA to serve (defaults to ./web or ../web/dist).
# WEB_DIST=

# --- Persistence (prod) ---
# Use a connection string (also works with Azurite), OR a storage account name
# with Managed Identity. If neither is set, a local JSON file store is used.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# LOCAL_DATA_DIR=local-data

# --- Access gate (optional) ---
# Comma-separated email domains allowed to use the app. Empty = allow any identity
# the platform authenticated (the AAD tenant already gates). e.g. microsoft.com
# ALLOWED_EMAIL_DOMAINS=
