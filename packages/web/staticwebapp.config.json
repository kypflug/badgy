{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{js,css,map,svg,png,ico,json,txt,webmanifest,woff,woff2}"]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet, noimageindex"
  }
}
